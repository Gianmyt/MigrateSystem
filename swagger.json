            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MigrationRequest": {
        "type": "object",
        "properties": {
          "oldUser": {
            "$ref": "#/components/schemas/OldUser"
          },
          "slotId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
